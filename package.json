{
  "name": "datetime-helper",
  "displayName": "DateTime Helper",
  "description": "Extension for inserting date and time",
  "main": "./out/extension.js",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.138.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:datetime-helper.insertDate",
    "onCommand:datetime-helper.insertTime",
    "onCommand:datetime-helper.insertDateTime"
],
"contributes": {
    "commands": [
        {
            "command": "datetime-helper.insertDate",
            "title": "DateTime Helper: Insert Date"
        },
        {
            "command": "datetime-helper.insertTime",
            "title": "DateTime Helper: Insert Time"
        },
        {
            "command": "datetime-helper.insertDateTime",
            "title": "DateTime Helper: Insert Date and Time"
        }
    ]
},
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.146.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
